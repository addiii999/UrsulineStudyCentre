# ============================================================
# URSULINE STUDY CENTRE — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Credentials (generate new hash with: npx bcryptjs-cli hash <password> 12)
ADMIN_USERNAME=your_admin_email@example.com
ADMIN_PASSWORD_HASH=your_bcrypt_hash_here
ADMIN_SESSION_SECRET=generate_random_32_char_secret_here

# JWT Secret (generate with: openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_here

# Email Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Cron Job Secret (generate with: openssl rand -hex 32)
CRON_SECRET=your_cron_secret_here

# Rate Limiting (optional - for Redis-based rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
